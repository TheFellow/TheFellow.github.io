"inventory" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Inventory</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">bounded context</FONT></TD></TR></TABLE>>, fillcolor="#21333e", color="#8bcafb", URL="https://github.com/TheFellow/go-modular-monolith/blob/0d5e64b0455f7a5c96d4afada64654a5fdbb9a2c/app/domains/inventory", target="_blank"];
"ingredients" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Ingredients</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">bounded context</FONT></TD></TR></TABLE>>, fillcolor="#21333e", color="#8bcafb", URL="https://github.com/TheFellow/go-modular-monolith/blob/0d5e64b0455f7a5c96d4afada64654a5fdbb9a2c/app/domains/ingredients", target="_blank"];
"drinks" -> "ingredients";
