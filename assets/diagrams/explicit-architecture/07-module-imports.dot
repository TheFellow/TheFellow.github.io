digraph G {
graph [bgcolor="transparent", rankdir=TB, pad=0.15, nodesep=0.45, ranksep=0.7, splines=spline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", color="#466879", fillcolor="#21333e", fontcolor="#fff6ed", fontname="Arial", fontsize=21, margin="0.20,0.14", penwidth=1.2];
edge [color="#8bcafb", arrowsize=0.8, penwidth=1.6];
"surfaces" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>surfaces/{cli,tui,gui}</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Native adapters</FONT></TD></TR></TABLE>>, fillcolor="#21333e", color="#8bcafb", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/surfaces", target="_blank"];
"facade" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>menus</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Public facade + construction</FONT></TD></TR></TABLE>>, fillcolor="#21333e", color="#8bcafb", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/", target="_blank"];
"queries" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>queries</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Public read contracts</FONT></TD></TR></TABLE>>, fillcolor="#21333e", color="#8bcafb", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/queries", target="_blank"];
"commands" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>internal/commands</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Write decisions</FONT></TD></TR></TABLE>>, fillcolor="#302b21", color="#f4c879", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/internal/commands", target="_blank"];
"dao" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>internal/dao</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Private persistence</FONT></TD></TR></TABLE>>, fillcolor="#302b21", color="#f4c879", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/internal/dao", target="_blank"];
"availability" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>internal/availability</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Readiness calculations</FONT></TD></TR></TABLE>>, fillcolor="#302b21", color="#f4c879", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/internal/availability", target="_blank"];
"handlers" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>handlers</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Owned event reactions</FONT></TD></TR></TABLE>>, fillcolor="#2e293b", color="#c8b1f1", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/handlers", target="_blank"];
"models" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>models</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Domain values + public types</FONT></TD></TR></TABLE>>, fillcolor="#25372e", color="#84e5b9", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/models", target="_blank"];
"events" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>events</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Facts owned by Menus</FONT></TD></TR></TABLE>>, fillcolor="#25372e", color="#84e5b9", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/events", target="_blank"];
"authz" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>authz</B></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#c1c6c4">Domain-owned Cedar vocabulary</FONT></TD></TR></TABLE>>, fillcolor="#25372e", color="#84e5b9", URL="https://github.com/TheFellow/go-modular-monolith/blob/a7c2efda8c0cd905089a27060242ff841bb0ad41/app/domains/menus/authz", target="_blank"];
"surfaces" -> "facade";
"surfaces" -> "models";
"surfaces" -> "queries";
"facade" -> "authz";
"facade" -> "commands";
"facade" -> "dao";
"facade" -> "models";
"facade" -> "queries";
"queries" -> "availability";
"queries" -> "dao";
"queries" -> "models";
"commands" -> "availability";
"commands" -> "dao";
"commands" -> "events";
"commands" -> "models";
"handlers" -> "availability";
"handlers" -> "dao";
"handlers" -> "events";
"handlers" -> "models";
"availability" -> "models";
"dao" -> "models";
"events" -> "models";
"models" -> "authz";
{rank=same; surfaces; handlers;}
}
